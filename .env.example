# Copy this file to .env (backend/.env) and fill in what you need.
# Nothing here is required to run the demo -- it works fully in DEMO_MODE
# with zero configuration.

# Leave blank to run in demo mode (deterministic local adjudicator, no
# network calls, no cost). Set a real key to route soft-claim adjudication
# through OpenAI instead.
OPENAI_API_KEY=

# "demo" or "openai". If unset, it's inferred from whether OPENAI_API_KEY
# is present.
LLM_MODE=demo

# Which OpenAI model to use when LLM_MODE=openai.
VERIDICT_OPENAI_MODEL=gpt-4o-mini

# Where the frontend should find the backend.
BACKEND_URL=http://localhost:8000
